PORT=4001

MYTT_UPSTREAM_ENABLED=true
MYTT_BASE_URL=https://www.mytischtennis.de
MYTT_MAX_REQUESTS_PER_HOUR=60

TTTRACKER_API_KEY=DEIN_BACKEND_API_KEY

# Für lokale Datei mit User-Cookies und Freigaben
TTTRACKER_SESSION_STORE_FILE=./data/mytt-sessions.json

# Mindestens 32 Zeichen, geheim halten.
# Beispiel lokal generieren:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TTTRACKER_SESSION_SECRET=DEIN_LANGER_GEHEIMER_SESSION_SECRET

# App-Login / JWT-ähnlicher Token
TTTRACKER_AUTH_SECRET=DEIN_LANGER_GEHEIMER_AUTH_SECRET_MIN_32_ZEICHEN
TTTRACKER_USER_STORE_FILE=./data/users.json

# Passwort-Reset
# Speicher für die (gehashten) Reset-Token
TTTRACKER_PASSWORD_RESET_STORE_FILE=./data/password-resets.json
# Mail-Versand per SMTP (nodemailer)
# Beispiel web.de: smtp.web.de / Port 587 / secure=false (STARTTLS)
# Beispiel GMX:     mail.gmx.net / Port 465 / secure=true
# Wichtig bei web.de/GMX: externen Zugriff (POP3/IMAP/SMTP) im Konto aktivieren!
SMTP_HOST=smtp.web.de
SMTP_PORT=587
# secure=true nur bei Port 465 (implizites TLS); bei Port 587 (STARTTLS) false.
# Wenn leer gelassen: bei Port 465 automatisch true, sonst false.
SMTP_SECURE=false
SMTP_USER=deinname@web.de
SMTP_PASS=DEIN_WEBDE_PASSWORT
# Absender-Adresse; wenn leer, wird SMTP_USER genutzt. Format "Name <mail>" oder nur "mail"
TTTRACKER_MAIL_FROM=TT Tracker <deinname@web.de>
# Basis-URL/Deep-Link für den Reset-Link in der Mail; der Token wird als ?token=... angehängt
TTTRACKER_RESET_URL_BASE=tttracker://reset-password

# Nur für Entwicklung:
# true erlaubt weiterhin x-tt-user-id als Fake-Login
TTTRACKER_DEV_USER_HEADER_ENABLED=true