PORT=4001

# Standard ist 127.0.0.1 (nur hinter Reverse Proxy erreichbar).
# Für lokales Testen mit dem Handy im selben WLAN: HOST=0.0.0.0
HOST=127.0.0.1

MYTT_UPSTREAM_ENABLED=true
MYTT_BASE_URL=https://www.mytischtennis.de

# Throttle: myTischtennis-Requests warten kurz in einer Warteschlange, statt abgelehnt zu werden.
MYTT_MAX_CONCURRENT=2
MYTT_MIN_INTERVAL_MS=1000
# Bei einem 429 verdoppelt sich das Intervall bis zu diesem Wert und schrumpft danach wieder.
MYTT_MAX_INTERVAL_MS=3000
# Eigenes Budget im rollenden 30 Minuten Fenster (myTischtennis erlaubt 360). 0 = aus.
MYTT_BUDGET_PER_30MIN=90
# Anteil davon, den Hintergrundarbeit (Aktualisierungen, Logos, Canary) nutzen darf. Der Rest bleibt für Nutzer.
MYTT_BACKGROUND_SHARE=0.6
# Webseite (HTML) als zweite Quelle, wenn die JSON-API für einen Pfad ausfällt
MYTT_HTML_FALLBACK_ENABLED=true
# Nur Entwicklung: JSON-API absichtlich scheitern lassen, um den HTML-Fallback zu testen
# MYTT_FORCE_API_FAILURE=true
# Nur Entwicklung: so tun, als leite myTischtennis auf /verify (Captcha) um, ohne echten Request
# MYTT_FORCE_CHALLENGE=true
# Pause nach einer /verify Weiterleitung (Standard 6 h), danach eine einzelne Probe. Jede erneute Challenge verdoppelt bis zum Maximum (Standard 24 h).
# MYTT_CHALLENGE_PAUSE_MS=21600000
# MYTT_CHALLENGE_MAX_PAUSE_MS=86400000
# TTR Schätzung (viele myTT Requests pro kaltem Lauf), Standard aus
# TTR_ESTIMATE_ENABLED=false

# Cache: abgelaufene Einträge bleiben als Notnagel erhalten (Standard 7 Tage)
CACHE_STALE_MAX_AGE_MS=604800000
# Dauerhafte Ablage (SQLite, Node 22.5 oder neuer): abgeschlossene Spielberichte und Gegnerwerte der TTR Schätzung
STORE_ENABLED=true
# STORE_FILE=./data/store.db

# Cache in data/cache.json sichern (alle 5 Minuten und beim Beenden) und beim Start laden
CACHE_PERSIST_ENABLED=true

TTTRACKER_API_KEY=DEIN_BACKEND_API_KEY

# Canary: prüft in diesem Abstand (Stunden) feste alte Saison Seiten gegen API und Webseite und
# meldet Formatänderungen per Mail an TTTRACKER_ALERT_EMAIL (benötigt die SMTP Einstellungen unten).
# 0 = aus (lokal), auf dem Server z.B. 24. Manuell: POST /api/admin/canary/run mit x-api-key.
CANARY_INTERVAL_HOURS=0
# TTTRACKER_ALERT_EMAIL=deinname@web.de

# Für lokale Datei mit User-Cookies und Freigaben
TTTRACKER_SESSION_STORE_FILE=./data/mytt-sessions.json

# Mindestens 32 Zeichen, geheim halten.
# Beispiel lokal generieren:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TTTRACKER_SESSION_SECRET=DEIN_LANGER_GEHEIMER_SESSION_SECRET

# App-Login / JWT-ähnlicher Token
TTTRACKER_AUTH_SECRET=DEIN_LANGER_GEHEIMER_AUTH_SECRET_MIN_32_ZEICHEN
TTTRACKER_USER_STORE_FILE=./data/users.json

# Passwort-Reset
# Speicher für die (gehashten) Reset-Token
TTTRACKER_PASSWORD_RESET_STORE_FILE=./data/password-resets.json
# Mail-Versand per SMTP (nodemailer)
# Beispiel web.de: smtp.web.de / Port 587 / secure=false (STARTTLS)
# Beispiel GMX:     mail.gmx.net / Port 465 / secure=true
# Wichtig bei web.de/GMX: externen Zugriff (POP3/IMAP/SMTP) im Konto aktivieren!
SMTP_HOST=smtp.web.de
SMTP_PORT=587
# secure=true nur bei Port 465 (implizites TLS); bei Port 587 (STARTTLS) false.
# Wenn leer gelassen: bei Port 465 automatisch true, sonst false.
SMTP_SECURE=false
SMTP_USER=deinname@web.de
SMTP_PASS=DEIN_WEBDE_PASSWORT
# Absender-Adresse; wenn leer, wird SMTP_USER genutzt. Format "Name <mail>" oder nur "mail"
TTTRACKER_MAIL_FROM=TT Tracker <deinname@web.de>
# Basis-URL/Deep-Link für den Reset-Link in der Mail; der Token wird als ?token=... angehängt
TTTRACKER_RESET_URL_BASE=tttracker://reset-password

# Nur für Entwicklung:
# true erlaubt weiterhin x-tt-user-id als Fake-Login
TTTRACKER_DEV_USER_HEADER_ENABLED=true

# Request log: ab dieser Größe (Bytes) wird logs/requests.jsonl weitergereicht, so viele alte Dateien bleiben
# TTTRACKER_LOG_MAX_BYTES=20971520
# TTTRACKER_LOG_KEEP_FILES=3
