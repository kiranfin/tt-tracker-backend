PORT=4001

MYTT_UPSTREAM_ENABLED=true
MYTT_BASE_URL=https://www.mytischtennis.de
MYTT_MAX_REQUESTS_PER_HOUR=60

TTTRACKER_API_KEY=DEIN_BACKEND_API_KEY

# Für lokale Datei mit User-Cookies und Freigaben
TTTRACKER_SESSION_STORE_FILE=./data/mytt-sessions.json

# Mindestens 32 Zeichen, geheim halten.
# Beispiel lokal generieren:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TTTRACKER_SESSION_SECRET=DEIN_LANGER_GEHEIMER_SESSION_SECRET

# App-Login / JWT-ähnlicher Token
TTTRACKER_AUTH_SECRET=DEIN_LANGER_GEHEIMER_AUTH_SECRET_MIN_32_ZEICHEN
TTTRACKER_USER_STORE_FILE=./data/users.json

# Nur für Entwicklung:
# true erlaubt weiterhin x-tt-user-id als Fake-Login
TTTRACKER_DEV_USER_HEADER_ENABLED=true